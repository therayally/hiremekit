---
/**
 * AppLayout — authenticated app area. Tighter, more product-y than marketing.
 */
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'HireMeKit app' } = Astro.props;
const userEmail = Astro.locals.user?.email ?? null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="app-body">
    <header class="app-header">
      <div class="app-header-inner">
        <a href="/app" class="app-brand">HireMeKit</a>
        <nav class="app-nav">
          <a href="/app/resume">Resume</a>
          <a href="/app/cover">Cover letter</a>
          <a href="/app/signature">Signature</a>
          <a href="/app/linkedin">LinkedIn</a>
          <a href="/app/portfolio">Portfolio</a>
        </nav>
        <div class="app-user">
          {userEmail && <span class="user-email">{userEmail}</span>}
          <form method="POST" action="/api/auth/logout" style="display:inline">
            <button type="submit" class="btn btn-ghost btn-sm">Sign out</button>
          </form>
        </div>
      </div>
    </header>
    <main class="app-main">
      <div class="app-container">
        <slot />
      </div>
    </main>
  </body>
</html>

<style>
  .app-body {
    background: var(--color-bg-section);
  }
  .app-header {
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .app-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
    padding: 0 var(--space-5);
    max-width: 1400px;
    margin: 0 auto;
    gap: var(--space-5);
  }
  .app-brand {
    font-weight: 600;
    font-size: var(--text-base);
    color: var(--color-fg);
    letter-spacing: -0.02em;
  }
  .app-brand:hover { text-decoration: none; }
  .app-nav {
    display: flex;
    gap: var(--space-5);
    flex: 1;
    overflow-x: auto;
  }
  .app-nav a {
    font-size: var(--text-sm);
    color: var(--color-fg-muted);
    white-space: nowrap;
  }
  .app-nav a:hover { color: var(--color-accent); text-decoration: none; }
  .app-user {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .user-email {
    font-size: var(--text-xs);
    color: var(--color-fg-subtle);
  }
  .btn-sm {
    padding: 6px 12px;
    font-size: var(--text-xs);
  }
  @media (max-width: 768px) {
    .app-nav { gap: var(--space-4); }
    .user-email { display: none; }
  }
  .app-main {
    padding: var(--space-7) 0;
  }
  .app-container {
    max-width: 980px;
    margin: 0 auto;
    padding: 0 var(--space-5);
  }
</style>

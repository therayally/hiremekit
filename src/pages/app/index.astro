---
import AppLayout from '../../layouts/AppLayout.astro';
const user = Astro.locals.user;
---

<AppLayout title="Dashboard — HireMeKit">
  <div class="dash-head">
    <h1>Welcome back{user?.email ? `, ${user.email}` : ''}</h1>
    <p>Pick a tool to start. Your saved drafts will show up here.</p>
  </div>

  <div class="dash-grid">
    <a href="/app/resume" class="tool-card">
      <h2>Build a resume</h2>
      <p>Upload, paste, talk, or answer questions. We'll structure it.</p>
    </a>
    <a href="/app/cover" class="tool-card">
      <h2>Cover letter</h2>
      <p>Generate a tailored cover letter in three lengths.</p>
    </a>
    <a href="/app/signature" class="tool-card">
      <h2>Email signature</h2>
      <p>Clean professional signature block for Gmail, Outlook, Apple Mail.</p>
    </a>
    <a href="/app/linkedin" class="tool-card">
      <h2>LinkedIn optimizer</h2>
      <p>Rewrite your headline and About section. Generate banners.</p>
    </a>
    <a href="/app/portfolio" class="tool-card">
      <h2>Portfolio site</h2>
      <p>Free hosting on yourname.hiremekit.app. Custom domain supported.</p>
    </a>
    <a href="/app/skills" class="tool-card">
      <h2>Skills assessment</h2>
      <p>20 questions per role. Get a skill profile and a learning roadmap.</p>
    </a>
  </div>
</AppLayout>

<style>
  .dash-head {
    margin-bottom: var(--space-7);
  }
  .dash-head h1 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-2);
  }
  .dash-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-4);
  }
  .tool-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    color: var(--color-fg);
    transition: transform 120ms, border-color 120ms, box-shadow 120ms;
    display: block;
  }
  .tool-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
    text-decoration: none;
  }
  .tool-card h2 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }
  .tool-card p {
    font-size: var(--text-sm);
    margin: 0;
  }
</style>
